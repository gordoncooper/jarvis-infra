# Laptop wake → https://jarvis.lan (D-0014). Copy to ~/.config/jarvis-wake/env (mode 600).
# Refresh from bastion:
#   scp agent@192.168.8.10:jarvis-infra/scripts/jarvis-wake.py ~/jarvis-wake.py
#   scp agent@192.168.8.10:.config/jarvis-wake/env ~/.config/jarvis-wake/env

ORCH_URL=https://jarvis.lan

# Optional: pin a session (otherwise cached in ~/.config/jarvis-wake/session)
# SESSION_ID=

# TLS: 1 = verify (default; install the CA with scripts/install-lan-ca.sh).
# Set 0 only on a laptop that does not trust the lab CA yet.
VERIFY_TLS=1

# Mic: empty = system default; or device index; or substring of device name (--list-devices)
# Example (Blue Yeti-style USB): MIC_DEVICE=Blue Microphones
# MIC_DEVICE=

# Wake / VAD knobs
WAKE_THR=0.6
WAKE_HITS=3
SILENCE_SEC=0.85
MIN_UTTER=0.40
MAX_UTTER=8.0

# Ignore wake scores after beep / Piper (stops TTS re-triggering hey_jarvis)
COOLDOWN_SEC=2.0

# Speak each sentence as it arrives rather than waiting for the whole reply.
# Measured on a seven-sentence answer: first audio at ~8s instead of ~17s.
# OFF by default because it is the one path that cannot be checked without a
# speaker — turn it on at the machine, after `jarvis-wake.py --selftest`.
STREAM_REPLY=0

# When a reply asks a question ("Shall I remember...? Say yes or cancel"),
# listen this long for the answer without needing the wake word again.
# 0 disables. FOLLOWUP_RMS is how loud speech must be to count as the answer.
FOLLOWUP_SEC=12.0
FOLLOWUP_RMS=600
