# Laptop wake → https://jarvis.lan (D-0014). Copy to ~/.config/jarvis-wake/env (mode 600).
# Refresh from bastion:
#   scp agent@192.168.8.10:jarvis-infra/scripts/jarvis-wake.py ~/jarvis-wake.py
#   scp agent@192.168.8.10:.config/jarvis-wake/env ~/.config/jarvis-wake/env

ORCH_URL=https://jarvis.lan

# Optional: pin a session (otherwise cached in ~/.config/jarvis-wake/session)
# SESSION_ID=

# TLS: 0 = accept LAN self-signed (default). 1 = verify once the laptop trusts the CA.
VERIFY_TLS=0

# Mic: empty = system default; or device index; or substring of device name (--list-devices)
# Example (Blue Yeti-style USB): MIC_DEVICE=Blue Microphones
# MIC_DEVICE=

# Wake / VAD knobs
WAKE_THR=0.6
WAKE_HITS=3
SILENCE_SEC=0.85
MIN_UTTER=0.40
MAX_UTTER=8.0

# Ignore wake scores after beep / Piper (stops TTS re-triggering hey_jarvis)
COOLDOWN_SEC=2.0
